{
  "name": "parking-mcp",
  "version": "0.1.0",
  "description": "Official Taipei and New Taipei parking availability MCP server",
  "type": "module",
  "license": "MIT",
  "bin": {
    "parking-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "e2e": "npm run build && node scripts/e2e.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fast-xml-parser": "^5.3.0",
    "proj4": "^2.19.10",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/proj4": "^2.5.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
